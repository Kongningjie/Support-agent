# 本文件只声明本地开发所需变量名，不得填写或提交真实凭据。
# Compose 宿主端口；已有本地服务占用默认端口时可以覆盖。
SUPPORT_AGENT_MYSQL_PORT=3306
SUPPORT_AGENT_REDIS_PORT=6379
SUPPORT_AGENT_ELASTICSEARCH_PORT=9200

SUPPORT_AGENT_MYSQL_URL=jdbc:mysql://localhost:3306/support_agent?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
SUPPORT_AGENT_MYSQL_USERNAME=support_agent
SUPPORT_AGENT_MYSQL_PASSWORD=
SUPPORT_AGENT_MYSQL_ROOT_PASSWORD=

SUPPORT_AGENT_REDIS_URL=redis://localhost:6379
SUPPORT_AGENT_REDIS_PASSWORD=

SUPPORT_AGENT_ELASTICSEARCH_URL=http://localhost:9200
SUPPORT_AGENT_ELASTICSEARCH_USERNAME=
SUPPORT_AGENT_ELASTICSEARCH_PASSWORD=
SUPPORT_AGENT_KNOWLEDGE_INDEX=support_knowledge_v1
SUPPORT_AGENT_KNOWLEDGE_ALIAS=support_knowledge_current

# 检索参数均为可选覆盖值；默认值是阶段 7 通过锁定回归的冻结生产参数。
SUPPORT_AGENT_BM25_TOP_K=30
SUPPORT_AGENT_VECTOR_TOP_K=30
SUPPORT_AGENT_VECTOR_CANDIDATES=100
SUPPORT_AGENT_VECTOR_MINIMUM_SIMILARITY=0.20
SUPPORT_AGENT_RRF_K=20
SUPPORT_AGENT_FUSION_TOP_K=20
SUPPORT_AGENT_RERANK_TOP_K=20
SUPPORT_AGENT_RANKED_TOP_K=10
SUPPORT_AGENT_FINAL_TOP_K=5
SUPPORT_AGENT_RERANK_GROUNDED_THRESHOLD=0.30
SUPPORT_AGENT_ANALYSIS_PROFILE=ICU_ONLY
SUPPORT_AGENT_TITLE_WEIGHT=3.0
SUPPORT_AGENT_HEADING_WEIGHT=2.0
SUPPORT_AGENT_CONTENT_WEIGHT=1.0
SUPPORT_AGENT_EXACT_TERM_WEIGHT=5.0

# 可选；多实例部署时应为每个应用实例设置唯一 Worker 标识。为空时应用启动时自动生成。
SUPPORT_AGENT_WORKER_ID=

DASHSCOPE_API_KEY=
SUPPORT_AGENT_EMBEDDING_MODEL=text-embedding-v4
