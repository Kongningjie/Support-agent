# 本文件只声明本地开发所需变量名，不得填写或提交真实凭据。
# Compose 宿主端口；已有本地服务占用默认端口时可以覆盖。
SUPPORT_AGENT_MYSQL_PORT=3306
SUPPORT_AGENT_REDIS_PORT=6379
SUPPORT_AGENT_ELASTICSEARCH_PORT=9200

SUPPORT_AGENT_MYSQL_URL=jdbc:mysql://localhost:3306/support_agent?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&connectTimeout=5000&socketTimeout=30000
SUPPORT_AGENT_MYSQL_USERNAME=support_agent
SUPPORT_AGENT_MYSQL_PASSWORD=
SUPPORT_AGENT_MYSQL_ROOT_PASSWORD=
SUPPORT_AGENT_MYSQL_POOL_TIMEOUT=5000
SUPPORT_AGENT_MYSQL_VALIDATION_TIMEOUT=3000

SUPPORT_AGENT_REDIS_URL=redis://localhost:6379
SUPPORT_AGENT_REDIS_PASSWORD=
SUPPORT_AGENT_REDIS_CONNECT_TIMEOUT=2s
SUPPORT_AGENT_REDIS_COMMAND_TIMEOUT=3s
SUPPORT_AGENT_REDIS_SHUTDOWN_TIMEOUT=2s

SUPPORT_AGENT_ELASTICSEARCH_URL=http://localhost:9200
SUPPORT_AGENT_ELASTICSEARCH_USERNAME=
SUPPORT_AGENT_ELASTICSEARCH_PASSWORD=
SUPPORT_AGENT_KNOWLEDGE_INDEX=support_knowledge_v1
SUPPORT_AGENT_KNOWLEDGE_ALIAS=support_knowledge_current
SUPPORT_AGENT_ELASTICSEARCH_CONNECT_TIMEOUT=2s
SUPPORT_AGENT_ELASTICSEARCH_CONNECTION_REQUEST_TIMEOUT=2s
SUPPORT_AGENT_ELASTICSEARCH_RESPONSE_TIMEOUT=10s

# 检索参数均为可选覆盖值；默认值是阶段 7 通过锁定回归的冻结生产参数。
SUPPORT_AGENT_BM25_TOP_K=30
SUPPORT_AGENT_VECTOR_TOP_K=30
SUPPORT_AGENT_VECTOR_CANDIDATES=100
SUPPORT_AGENT_VECTOR_MINIMUM_SIMILARITY=0.20
SUPPORT_AGENT_RRF_K=20
SUPPORT_AGENT_FUSION_TOP_K=20
SUPPORT_AGENT_RERANK_TOP_K=20
SUPPORT_AGENT_RANKED_TOP_K=10
SUPPORT_AGENT_FINAL_TOP_K=5
SUPPORT_AGENT_RERANK_GROUNDED_THRESHOLD=0.30
SUPPORT_AGENT_ANALYSIS_PROFILE=ICU_ONLY
SUPPORT_AGENT_TITLE_WEIGHT=3.0
SUPPORT_AGENT_HEADING_WEIGHT=2.0
SUPPORT_AGENT_CONTENT_WEIGHT=1.0
SUPPORT_AGENT_EXACT_TERM_WEIGHT=5.0

# 可选；多实例部署时应为每个应用实例设置唯一 Worker 标识。为空时应用启动时自动生成。
SUPPORT_AGENT_WORKER_ID=
SUPPORT_AGENT_ASYNC_TASK_RETRY_DELAYS=30s,2m,10m
SUPPORT_AGENT_CONVERSATION_TTL=7d
SUPPORT_AGENT_SUGGESTION_TTL=24h
SUPPORT_AGENT_CHAT_RUN_LEASE=3m
SUPPORT_AGENT_SUGGESTION_LEASE=3m
SUPPORT_AGENT_CONVERSATION_INPUT_BUDGET_TOKENS=24000
SUPPORT_AGENT_CONVERSATION_OUTPUT_RESERVE_TOKENS=1200
SUPPORT_AGENT_CONVERSATION_SAFETY_MARGIN_TOKENS=1024
SUPPORT_AGENT_CONVERSATION_RECENT_FULL_TURNS=6
SUPPORT_AGENT_CONVERSATION_SOFT_TRIGGER_TURNS=12
SUPPORT_AGENT_CONVERSATION_SOFT_TRIGGER_MEMORY_TOKENS=6000
SUPPORT_AGENT_CONVERSATION_HARD_TRIGGER_TURNS=20

# LLM 输入、上下文和输出安全；生产环境不得关闭四个安全开关，且重生成次数固定为 1。
SUPPORT_AGENT_LLM_SECURITY_ENABLED=true
SUPPORT_AGENT_LLM_BLOCK_HIGH_CONFIDENCE_INPUT=true
SUPPORT_AGENT_LLM_EXCLUDE_HIGH_RISK_CONTEXT=true
SUPPORT_AGENT_LLM_PROMPT_CANARY_ENABLED=true
SUPPORT_AGENT_LLM_MAXIMUM_REGENERATIONS=1

# 仅在 app_user 为空时启用一次；真实密码不得提交到 Git
SUPPORT_AGENT_AUTH_TOKEN_TTL=2h
# 每位用户最多保留的有效 Token 数，签发超限时撤销最早 Token。
SUPPORT_AGENT_AUTH_MAXIMUM_ACTIVE_TOKENS=5
SUPPORT_AGENT_BOOTSTRAP_ADMIN_ENABLED=false
SUPPORT_AGENT_BOOTSTRAP_ADMIN_USERNAME=
SUPPORT_AGENT_BOOTSTRAP_ADMIN_DISPLAY_NAME=
SUPPORT_AGENT_BOOTSTRAP_ADMIN_PASSWORD=

DASHSCOPE_API_KEY=
DASHSCOPE_HTTP_BASE_URL=https://dashscope.aliyuncs.com/api/v1
SUPPORT_AGENT_CHAT_MODEL=qwen3.8-flash
SUPPORT_AGENT_INTENT_MODEL=qwen3.7-flash
SUPPORT_AGENT_SUMMARY_MODEL=qwen3.7-flash
SUPPORT_AGENT_EMBEDDING_MODEL=text-embedding-v4
SUPPORT_AGENT_RERANK_MODEL=qwen3-rerank
SUPPORT_AGENT_CHAT_TIMEOUT=120s
SUPPORT_AGENT_INTENT_TIMEOUT=3s
SUPPORT_AGENT_SUMMARY_TIMEOUT=30s
SUPPORT_AGENT_TICKET_TIMEOUT=30s
SUPPORT_AGENT_RESOLVED_CASE_TIMEOUT=60s
SUPPORT_AGENT_EMBEDDING_TIMEOUT=10s
SUPPORT_AGENT_RERANK_TIMEOUT=10s
SUPPORT_AGENT_MODEL_RETRY_MAX_ATTEMPTS=3
SUPPORT_AGENT_MODEL_RETRY_INITIAL_DELAY=100ms
SUPPORT_AGENT_CHAT_MAX_OUTPUT_TOKENS=1200
SUPPORT_AGENT_INTENT_MAX_OUTPUT_TOKENS=256
SUPPORT_AGENT_SUMMARY_MAX_OUTPUT_TOKENS=1200
SUPPORT_AGENT_STRUCTURED_MAX_OUTPUT_TOKENS=800
SUPPORT_AGENT_GROUNDED_PROMPT_VARIANT=ORIGINAL

# Outbox 运行指标写入本地 Micrometer Gauge 的采样周期。
SUPPORT_AGENT_OUTBOX_SAMPLE_DELAY=10s
