<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lawrence.supportagent.persistence.mapper.SecurityEventMapper">
    <insert id="insert">
        INSERT INTO security_event
            (event_type,target_user_id,actor_id,result,reason,source_hash,occurred_at)
        VALUES
            (#{eventType},#{targetUserId},#{actorId},#{result},#{reason},#{sourceHash},#{occurredAt})
    </insert>
</mapper>
